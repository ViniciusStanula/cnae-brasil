---
import { getCollection } from 'astro:content';
import HubLayout from '../layouts/HubLayout.astro';
import SearchBox from '../components/search/SearchBox.astro';
import { buildCanonical } from '../lib/seo.js';
import { buildSearchIndex } from '../lib/search.js';
import { homeCrumb } from '../lib/breadcrumbs.js';
import { formatCodigoForDisplay } from '../lib/cnae-helpers.js';

const entries = await getCollection('cnae');
const searchItems = buildSearchIndex(entries.map((e) => e.data));

const query = Astro.url.searchParams.get('q') ?? '';

// Simple static filter: match query against code or description
const results = query.length >= 2
  ? entries
      .filter((e) => {
        const q = query.toLowerCase();
        return (
          e.data.codigo.toLowerCase().includes(q) ||
          e.data.codigo_slug.includes(q) ||
          e.data.codigo_numerico.includes(q) ||
          e.data.descricao_oficial.toLowerCase().includes(q) ||
          e.data.descricao_plana.toLowerCase().includes(q)
        );
      })
      .slice(0, 50)
  : [];

const title = query
  ? `Busca por "${query}" — CNAE Brasil`
  : 'Buscar CNAE | CNAE Brasil';
const description = `Busque entre ${entries.length} códigos CNAE por número ou nome da atividade.`;
const canonical = buildCanonical('/buscar/');

const crumbs = [homeCrumb(), { label: 'Buscar', href: '/buscar/', current: true }];
---

<HubLayout {title} {description} canonical={canonical} {crumbs} noindex={!!query}>
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Buscar CNAE</h1>

  <div class="mb-6">
    <SearchBox items={searchItems} placeholder="Digite um código ou atividade…" />
  </div>

  {query && (
    <div>
      <p class="text-sm text-gray-500 mb-4">
        {results.length > 0
          ? `${results.length} resultado(s) para "${query}"`
          : `Nenhum resultado para "${query}"`}
      </p>

      {results.length > 0 && (
        <ul class="space-y-2">
          {results.map((e) => (
            <li>
              <a
                href={`/cnae/${e.data.codigo_slug}/`}
                class="flex items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 hover:border-blue-400 hover:shadow-sm transition-all"
              >
                <code class="text-sm font-mono font-bold text-blue-700 whitespace-nowrap mt-0.5">
                  {formatCodigoForDisplay(e.data.codigo_slug)}
                </code>
                <div class="min-w-0">
                  <p class="text-sm text-gray-800 line-clamp-2">{e.data.descricao_oficial}</p>
                  <div class="flex gap-2 mt-1">
                    <span class={`text-xs font-medium ${e.data.mei.permitido ? 'text-green-700' : 'text-red-600'}`}>
                      MEI: {e.data.mei.permitido ? 'Sim' : 'Não'}
                    </span>
                    <span class="text-xs text-gray-400">·</span>
                    <span class="text-xs text-gray-500">Seção {e.data.secao.letra}</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}

      {results.length === 0 && (
        <div class="text-center py-10 text-gray-500">
          <p class="text-lg font-medium">Nenhum CNAE encontrado</p>
          <p class="text-sm mt-1">Tente um código numérico (ex: 4711) ou palavras da descrição</p>
          <a href="/cnae/" class="inline-block mt-4 text-blue-700 font-medium hover:underline text-sm">
            Explorar todos os CNAEs →
          </a>
        </div>
      )}
    </div>
  )}

  {!query && (
    <div class="text-center py-10 text-gray-400">
      <p>Digite um código CNAE (ex: 4711) ou nome de atividade para buscar</p>
    </div>
  )}
</HubLayout>
