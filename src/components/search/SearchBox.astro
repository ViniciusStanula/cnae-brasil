---
interface SearchItem {
  slug: string;
  label: string;
}

interface Props {
  items: SearchItem[];
  placeholder?: string;
  maxSuggestions?: number;
}

const { items, placeholder = 'Digite um código ou atividade…', maxSuggestions = 500 } = Astro.props;
const listId = 'cnae-search-list';
---

<form action="/buscar/" method="get" class="flex gap-2" role="search">
  <div class="flex-1 relative">
    <input
      id="cnae-search-input"
      type="search"
      name="q"
      list={listId}
      placeholder={placeholder}
      autocomplete="off"
      class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
      aria-label="Buscar CNAE"
    />
    <datalist id={listId}>
      {items.slice(0, maxSuggestions).map((item) => (
        <option value={item.label} />
      ))}
    </datalist>
  </div>
  <button
    type="submit"
    class="rounded-xl bg-blue-700 text-white px-5 py-3 text-sm font-semibold hover:bg-blue-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400"
    aria-label="Buscar"
  >
    Buscar
  </button>
</form>

<script define:vars={{ items }}>
  const input = document.getElementById('cnae-search-input');
  // When user picks a datalist suggestion, navigate directly to the CNAE page
  input.addEventListener('change', () => {
    const val = input.value;
    const match = items.find((item) => item.label === val);
    if (match) {
      window.location.href = `/cnae/${match.slug}/`;
    }
  });
</script>
