---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class={`block rounded-xl border border-gray-200 bg-white p-4 shadow-sm ${href ? 'hover:border-blue-400 hover:shadow-md transition-all' : ''} ${cls}`}
>
  <slot />
</Tag>
