---
import { SITE_NAME, SITE_URL } from '../../lib/constants.js';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  robots?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  robots = 'index, follow',
  jsonLd,
  noindex = false,
} = Astro.props;

const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const robotsMeta = noindex ? 'noindex, nofollow' : robots;

const jsonLdArr = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Render hints -->
<meta name="theme-color" content="#1e3a8a" />
<meta name="color-scheme" content="light" />
<meta name="format-detection" content="telephone=no" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical & robots -->
<link rel="canonical" href={canonical} />
<meta name="robots" content={robotsMeta} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Google Search Console -->
<meta name="google-site-verification" content="zkxs_hQn68k35oqZKn8wrshjpYBFCDU1F0bITHFh04Y" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<!-- JSON-LD -->
{jsonLdArr.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
