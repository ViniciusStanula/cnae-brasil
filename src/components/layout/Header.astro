---
import { SITE_NAME, SITE_TAGLINE } from '../../lib/constants.js';

const navLinks = [
  { href: '/cnae/', label: 'Todos os CNAEs' },
  { href: '/mei/', label: 'MEI' },
  { href: '/buscar/', label: 'Buscar' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-blue-900 text-white">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex flex-col leading-tight hover:opacity-90 transition-opacity">
      <span class="font-bold text-xl">{SITE_NAME}</span>
      <span class="text-blue-200 text-xs hidden sm:block">{SITE_TAGLINE}</span>
    </a>
    <nav aria-label="Navegação principal">
      <ul class="flex gap-1 sm:gap-2 flex-wrap">
        {navLinks.map(({ href, label }) => {
          const isCurrent = currentPath === href || (href !== '/' && currentPath.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class={`px-2 sm:px-3 py-1.5 rounded text-sm font-medium transition-colors ${
                  isCurrent
                    ? 'bg-blue-700 text-white'
                    : 'text-blue-100 hover:bg-blue-800 hover:text-white'
                }`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
