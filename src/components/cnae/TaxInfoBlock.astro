---
import { ANEXO_BY_CODE } from '../../lib/constants.js';
import type { CnaeEntry } from '../../content.config.js';

interface Props {
  simplestNacional: CnaeEntry['simples_nacional'];
}

const { simplestNacional } = Astro.props;
const info = ANEXO_BY_CODE.get(simplestNacional.anexo);
---

<section class="mb-8">
  <h2 class="text-xl font-bold text-gray-900 mb-3">Regime tributário</h2>
  <div class="bg-gray-50 rounded-xl border border-gray-200 p-5">
    <div class="flex flex-wrap gap-4 mb-3">
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Simples Nacional</p>
        <p class="text-lg font-bold text-gray-900">{info?.nome ?? simplestNacional.anexo}</p>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Tipo de atividade</p>
        <p class="font-semibold text-gray-800">{info?.tipo ?? '–'}</p>
      </div>
      {info && info.anexo !== 'nao_aplicavel' && (
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Alíquota</p>
          <p class="font-semibold text-gray-800">{info.aliquota_min} a {info.aliquota_max}</p>
        </div>
      )}
    </div>
    {simplestNacional.observacao && (
      <p class="text-sm text-gray-600 italic">{simplestNacional.observacao}</p>
    )}
    <p class="text-xs text-gray-400 mt-3">
      As alíquotas do Simples Nacional variam conforme o faturamento acumulado dos últimos 12 meses.
      Consulte as tabelas vigentes no Portal do Simples Nacional (PGDAS).
    </p>
  </div>
</section>
