---
import { formatCodigoForDisplay } from '../../lib/cnae-helpers.js';

interface Props {
  codigoSlug: string;
  descricaoPlana: string;
  descricaoOficial: string;
}

const { codigoSlug, descricaoPlana, descricaoOficial } = Astro.props;
const display = formatCodigoForDisplay(codigoSlug);
---

<div class="mb-6">
  <div class="flex flex-wrap items-start gap-3 mb-2">
    <code class="text-2xl font-mono font-bold text-blue-700 bg-blue-50 px-3 py-1 rounded-lg border border-blue-200">
      {display}
    </code>
  </div>
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight mb-2">
    CNAE {display} — {descricaoPlana.length > 80 ? descricaoPlana.slice(0, 80) + '…' : descricaoPlana}
  </h1>
  <p class="text-gray-600 text-base leading-relaxed">
    {descricaoPlana}
  </p>
</div>
