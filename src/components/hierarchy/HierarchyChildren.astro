---
interface Child {
  label: string;
  href: string;
  count?: number;
  description?: string;
}

interface Props {
  children: Child[];
  type?: 'list' | 'grid';
}

const { children, type = 'list' } = Astro.props;
---

{type === 'grid' ? (
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {children.map((c) => (
      <a
        href={c.href}
        class="rounded-xl border border-gray-200 bg-white p-4 hover:border-blue-400 hover:shadow-sm transition-all"
      >
        <p class="font-semibold text-gray-900 text-sm">{c.label}</p>
        {c.description && <p class="text-xs text-gray-500 mt-1 line-clamp-2">{c.description}</p>}
        {c.count !== undefined && <p class="text-xs text-blue-600 mt-1">{c.count} subclasses</p>}
      </a>
    ))}
  </div>
) : (
  <ul class="space-y-2">
    {children.map((c) => (
      <li>
        <a
          href={c.href}
          class="flex items-center justify-between gap-3 rounded-lg border border-gray-100 bg-gray-50 px-4 py-2.5 hover:border-blue-300 hover:bg-blue-50 transition-all group"
        >
          <span class="text-sm text-gray-800 group-hover:text-blue-800">{c.label}</span>
          {c.count !== undefined && (
            <span class="text-xs text-gray-400 flex-shrink-0">{c.count}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}
